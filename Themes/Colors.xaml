<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         Color Definitions
         Discord/Start11-inspired dark theme palette
         ================================================================ -->

    <!-- Background Colors -->
    <Color x:Key="BackgroundColor">#1e1f22</Color>
    <Color x:Key="SurfaceColor">#2b2d31</Color>
    <Color x:Key="SurfaceLightColor">#313338</Color>
    <Color x:Key="SurfaceLighterColor">#3b3d42</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentColor">#5865f2</Color>
    <Color x:Key="AccentHoverColor">#4752c4</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#f2f3f5</Color>
    <Color x:Key="TextSecondaryColor">#949ba4</Color>
    <Color x:Key="TextMutedColor">#72767d</Color>

    <!-- Border & State Colors -->
    <Color x:Key="BorderColor">#3f4147</Color>
    <Color x:Key="DangerColor">#ed4245</Color>
    <Color x:Key="SuccessColor">#57f287</Color>

    <!-- Edit Mode (amber) — used to differentiate edit views from search views -->
    <Color x:Key="EditAccentColor">#e8a23c</Color>
    <Color x:Key="EditAccentSubtleColor">#1ee8a23c</Color>

    <!-- Title Bar -->
    <Color x:Key="TitleBarColor">#1e1f22</Color>

    <!-- Input -->
    <Color x:Key="InputBackgroundColor">#1e1f22</Color>

    <!-- Button Colors -->
    <Color x:Key="ButtonBgColor">#3b3d42</Color>
    <Color x:Key="ButtonHoverColor">#45474e</Color>
    <Color x:Key="ButtonActiveColor">#4f5158</Color>

    <!-- Close Button -->
    <Color x:Key="CloseHoverColor">#e81123</Color>

    <!-- ScrollBar -->
    <Color x:Key="ScrollThumbColor">#505258</Color>

    <!-- Accent at 10% opacity for selected items -->
    <Color x:Key="AccentSubtleColor">#195865f2</Color>


    <!-- ================================================================
         SolidColorBrush Resources
         ================================================================ -->

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}" />
    <SolidColorBrush x:Key="SurfaceLighterBrush" Color="{StaticResource SurfaceLighterColor}" />

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Border & State Brushes -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <!-- Edit Mode Brushes -->
    <SolidColorBrush x:Key="EditAccentBrush" Color="{StaticResource EditAccentColor}" />
    <SolidColorBrush x:Key="EditAccentSubtleBrush" Color="{StaticResource EditAccentSubtleColor}" />

    <!-- Title Bar Brush -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />

    <!-- Input Brush -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />

    <!-- Button Brushes -->
    <SolidColorBrush x:Key="ButtonBgBrush" Color="{StaticResource ButtonBgColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonActiveBrush" Color="{StaticResource ButtonActiveColor}" />

    <!-- Close Button Brush -->
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />

    <!-- ScrollBar Brush -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />

    <!-- Accent Subtle Brush (10% opacity) -->
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />


    <!-- ================================================================
         Typography Resources
         ================================================================ -->

    <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

    <sys:Double x:Key="BodyFontSize"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="HeadingFontSize"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
    <sys:Double x:Key="CaptionFontSize"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>

</ResourceDictionary>
