<Window x:Class="Modinator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Modinator.Themes"
        Title="Grandeu: Reforged"
        Icon="Assets/app-icon.ico"
        Width="1100" Height="750"
        MinWidth="800" MinHeight="500"
        Style="{StaticResource ModernWindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Sidebar ═══════════ -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <DockPanel>

                <!-- Status bar pinned to bottom -->
                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource BackgroundBrush}"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="Ready"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" />
                        <ProgressBar x:Name="ScanProgress"
                                     Height="3" Margin="0,8,0,0"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Scrollable sidebar body -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,8">

                        <!-- ── Home ── -->
                        <Button x:Name="BtnHome"
                                Style="{StaticResource SidebarButton}"
                                Click="BtnHome_Click" Tag="Home"
                                Margin="0,4,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- ── Search ── -->
                        <TextBlock Text="S E A R C H"
                                   Style="{StaticResource SectionHeader}" />

                        <Button x:Name="BtnSearchItem"
                                Style="{StaticResource SidebarButton}"
                                Click="NavButton_Click" Tag="ItemSearch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xECAD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7" />
                                <TextBlock Text="Item" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSearchHero"
                                Style="{StaticResource SidebarButton}"
                                Click="NavButton_Click" Tag="HeroSearch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7" />
                                <TextBlock Text="Hero" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSearchMisc"
                                Style="{StaticResource SidebarButton}"
                                Click="NavButton_Click" Tag="MiscSearch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7" />
                                <TextBlock Text="Misc" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnForgeViewer"
                                Style="{StaticResource SidebarButton}"
                                Click="NavButton_Click" Tag="ForgeViewer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7" />
                                <TextBlock Text="Forge Viewer" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnHeroViewer"
                                Style="{StaticResource SidebarButton}"
                                Click="NavButton_Click" Tag="HeroViewer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7" />
                                <TextBlock Text="Hero Viewer" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnItemDupe"
                                Style="{StaticResource SidebarButton}"
                                Click="NavButton_Click" Tag="ItemDupe">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7" />
                                <TextBlock Text="Item Dupe" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSettings"
                                Style="{StaticResource SidebarButton}"
                                Click="NavButton_Click" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                Margin="14,10" />

                        <!-- ── Game Speed (TimeDilation) ── -->
                        <Grid Margin="16,0,14,6">
                            <TextBlock Text="G A M E   S P E E D"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0" />
                        </Grid>
                        <!-- Preset row: one-click at common multipliers. -->
                        <Grid Margin="16,0,14,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="0.5x" Padding="0,4" Margin="0,0,2,0"
                                    ToolTip="Half game speed"
                                    Click="BtnSpeedPreset_Click" Tag="0.5" />
                            <Button Grid.Column="1" Content="1x" Padding="0,4" Margin="2,0,2,0"
                                    ToolTip="Normal game speed"
                                    Click="BtnSpeedPreset_Click" Tag="1" />
                            <Button Grid.Column="2" Content="5x" Padding="0,4" Margin="2,0,2,0"
                                    ToolTip="5× game speed (physics/animation may glitch above ~3×)"
                                    Click="BtnSpeedPreset_Click" Tag="5" />
                            <Button Grid.Column="3" Content="15x" Padding="0,4" Margin="2,0,0,0"
                                    ToolTip="15× game speed (expect physics/animation glitches)"
                                    Click="BtnSpeedPreset_Click" Tag="15" />
                        </Grid>
                        <!-- Custom value row: TextBox + APPLY. Enter also
                             applies (handled in KeyDown). -->
                        <Grid Margin="16,0,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGameSpeed" Grid.Column="0"
                                     Padding="6,4" Margin="0,0,6,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="TxtGameSpeed_KeyDown"
                                     ToolTip="Game speed multiplier (0.05 - 15). Physics/animation gets glitchy above ~3. Enter to apply." />
                            <Button x:Name="BtnGameSpeedApply" Grid.Column="1"
                                    Content="APPLY" Padding="10,4"
                                    Click="BtnGameSpeedApply_Click" />
                        </Grid>

                        <!-- Results is search-context UI: the whole section
                             (its leading divider, header and list) toggles as
                             one unit via ResultsSection — shown only while a
                             search tab is active. -->
                        <StackPanel x:Name="ResultsSection">
                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                Margin="14,10" />

                        <!-- ── Results ── -->
                        <Grid Margin="16,0,14,0">
                            <TextBlock Text="R E S U L T S"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0" />
                            <TextBlock x:Name="ResultsCountText"
                                       Text="0"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10.5" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Search results list -->
                        <ListBox x:Name="ResultsList"
                                 MaxHeight="340"
                                 Margin="4,4,4,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ToolTip="Double-click a result to open it in the editor."
                                 MouseDoubleClick="ResultsList_DoubleClick"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Display}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="11.5"
                                                       FontFamily="Consolas, Cascadia Code, monospace" />
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <DockPanel Margin="0,1,0,0">
                                            <TextBlock Text="{Binding Quality}"
                                                       Foreground="{Binding QualityColor}"
                                                       FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Extra}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10"
                                                       Margin="8,0,0,0"
                                                       HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════════ Divider ═══════════ -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

        <!-- ═══════════ Main Content ═══════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TrackedRow" Height="220" MinHeight="80" />
            </Grid.RowDefinitions>

            <!-- Active view content area (Welcome is set in code-behind) -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundBrush}">
                <!-- Stretch so the hosted view fills (and is bounded by) this
                     cell; otherwise a tall view measures with unbounded
                     height and its inner ScrollViewer never scrolls. -->
                <ContentControl x:Name="ContentArea"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>

            <!-- Splitter -->
            <GridSplitter x:Name="TrackedSplitter" Grid.Row="1" Height="4"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <!-- ═══════════ Tracked Items Panel ═══════════ -->
            <Border x:Name="TrackedPanel" Grid.Row="2" Background="{StaticResource SurfaceBrush}">
                <DockPanel>
                    <!-- Panel header -->
                    <Border DockPanel.Dock="Top" Padding="14,8"
                            Background="{StaticResource SurfaceLightBrush}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8FD;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Tracked Items"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="SelectionText"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Tracked items grid -->
                    <ListView x:Name="TrackedList"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Extended"
                              ToolTip="Double-click to open in the editor. Right-click for freeze/remove options."
                              MouseDoubleClick="TrackedList_DoubleClick">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open Editor" FontWeight="SemiBold"
                                          Click="TrackedItem_OpenEditor" />
                                <MenuItem Header="Freeze / Unfreeze"
                                          Click="TrackedItem_Freeze" />
                                <Separator />
                                <MenuItem Header="Copy Address"
                                          Click="TrackedItem_CopyAddress" />
                                <Separator />
                                <MenuItem Header="Remove"
                                          Click="TrackedItem_Remove" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Address" Width="110"
                                                DisplayMemberBinding="{Binding AddressText}" />
                                <GridViewColumn Header="Type" Width="75"
                                                DisplayMemberBinding="{Binding TypeText}" />
                                <GridViewColumn Header="Name" Width="180"
                                                DisplayMemberBinding="{Binding Description}" />
                                <GridViewColumn Header="Quality" Width="90"
                                                DisplayMemberBinding="{Binding Quality}" />
                                <GridViewColumn Header="Level" Width="70"
                                                DisplayMemberBinding="{Binding Level}" />
                                <GridViewColumn Header="Forger" Width="130"
                                                DisplayMemberBinding="{Binding ForgerName}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
