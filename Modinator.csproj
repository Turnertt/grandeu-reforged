<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AssemblyName>GrandeuReforged</AssemblyName>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PlatformTarget)' == 'ARM64'">
    <DefineConstants>$(DefineConstants);ARM64_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>

</Project>
