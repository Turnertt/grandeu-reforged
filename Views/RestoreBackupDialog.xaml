<Window x:Class="Modinator.Views.RestoreBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore a save backup"
        Width="640" Height="460"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource ModernWindowStyle}">

    <DockPanel>
        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="LblGameState"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OPEN FOLDER" Padding="16,7" Height="32"
                            ToolTip="Show the selected backup in Explorer."
                            Click="BtnOpen_Click" />
                    <Button Content="CLOSE" IsCancel="True" Padding="16,7" Height="32"
                            Margin="8,0,0,0" />
                    <Button x:Name="BtnRestore" Content="RESTORE"
                            Style="{StaticResource DangerButton}"
                            Padding="16,7" Height="32" Margin="8,0,0,0"
                            ToolTip="Copy the selected backup over the game's save file. The game must be closed."
                            Click="BtnRestore_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="R E S T O R E   S A V E"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="Bold" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                    Pick a backup and press RESTORE. Close Dungeon Defenders first — a running game
                    overwrites the file on its next save. The current save is backed up automatically
                    ("Before restore") so a restore can always be undone. If Steam Cloud is on, Steam
                    uploads the restored file when the game next starts; if it shows a sync conflict,
                    choose the local file.
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Margin="8">
            <ListView x:Name="BackupList" Background="Transparent" BorderThickness="0"
                      SelectionMode="Single"
                      SelectionChanged="BackupList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Created" Width="150" DisplayMemberBinding="{Binding Created}" />
                        <GridViewColumn Header="Kind" Width="110" DisplayMemberBinding="{Binding Kind}" />
                        <GridViewColumn Header="Save written" Width="150" DisplayMemberBinding="{Binding SaveWritten}" />
                        <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}" />
                        <GridViewColumn Header="Files" Width="50" DisplayMemberBinding="{Binding Files}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="LblEmpty"
                       Text="No backups yet. One is taken automatically at startup and before your first edit, or press BACKUP NOW in Settings."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="40" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
