<Window x:Class="Modinator.Views.DisclaimerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Before you continue"
        Width="580" Height="500"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource ModernWindowStyle}">

    <DockPanel>
        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="LblFoot"
                           Text="You can read this again any time from Settings → Actions."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnExit" Content="EXIT" IsCancel="True" Padding="16,7" Height="32"
                            ToolTip="Close the tool without accepting."
                            Click="BtnExit_Click" />
                    <Button x:Name="BtnAccept" Content="I UNDERSTAND"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7" Height="32" Margin="8,0,0,0"
                            Click="BtnAccept_Click"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="P L E A S E   R E A D"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Grandeu: Reforged edits Dungeon Defenders' live game memory. A few things you need to know before using it."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <Border Background="{StaticResource AccentSubtleBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Not for online or Ranked play"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                            This tool is not supported and not recommended in online games or in Ranked mode.
                            Ranked stats are checked on Trendy's servers; using an editor there can get your
                            heroes wiped or your account banned, and nothing in this tool can prevent that.
                            Use it in solo, local and private / open games only.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="Your game can break"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12">
                    Writing to a running game is inherently risky. Edits can crash Dungeon Defenders,
                    corrupt items or heroes, or damage your save file. Game updates can also change
                    memory layouts without warning.
                </TextBlock>

                <TextBlock Text="Backups"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12">
                    The tool copies your save file (DunDefHeroes.dun) automatically at startup and
                    before the first edit of every session, and you can restore any copy from
                    Settings → Save Backups. Still keep your own backups of anything you care about.
                </TextBlock>

                <TextBlock Text="Use at your own risk"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                    By continuing you accept that you use this tool entirely at your own risk. The
                    authors are not responsible for broken games, lost items or heroes, corrupted
                    saves, or banned accounts. This project is not affiliated with Trendy Entertainment
                    or Chromatic Games.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
