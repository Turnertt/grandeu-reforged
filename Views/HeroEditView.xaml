<UserControl x:Class="Modinator.Views.HeroEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:Modinator.Behaviors">

    <DockPanel>
        <!-- Edit mode accent strip -->
        <Border DockPanel.Dock="Top" Height="2"
                Background="{StaticResource EditAccentBrush}" />
        <!-- Top action bar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnBack"
                            Content="&#x2190;  BACK"
                            Style="{StaticResource GhostButton}"
                            Padding="14,6"
                            Click="BtnBack_Click" />
                    <Button x:Name="BtnRefresh"
                            Content="REFRESH"
                            Padding="16,7"
                            Margin="8,0,0,0"
                            Click="BtnRefresh_Click" />
                    <Button x:Name="BtnMax"
                            Content="MAX"
                            Padding="16,7"
                            Margin="8,0,0,0"
                            Click="BtnMax_Click"
                            ToolTip="Fill the form with configured max values. Gear button configures the values." />
                    <Button x:Name="BtnMaxConfig"
                            Content="&#xE713;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Padding="8,7"
                            Margin="2,0,0,0"
                            Click="BtnMaxConfig_Click"
                            ToolTip="Configure max stats" />
                    <Button x:Name="BtnUpdate"
                            Content="UPDATE"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7"
                            Margin="8,0,0,0"
                            Click="BtnUpdate_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text=""
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border Background="{StaticResource EditAccentSubtleBrush}"
                            BorderBrush="{StaticResource EditAccentBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="{StaticResource EditAccentBrush}"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="EDIT · HERO"
                                       Foreground="{StaticResource EditAccentBrush}"
                                       FontSize="10.5" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable form area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel MaxWidth="560">

                <!-- Hero Stats -->
                <TextBlock Text="HERO STATS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Health" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/hero_health.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtHeroHealth" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Speed" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/hero_speed.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtHeroSpeed" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Damage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/hero_damage.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtHeroDamage" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Casting" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/hero_casting.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtHeroCasting" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Skill 1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHeroSkill1" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Skill 2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHeroSkill2" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tower Stats -->
                <TextBlock Text="TOWER STATS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Health" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/tower_health.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtTowerHealth" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Speed" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/tower_speed.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtTowerSpeed" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Damage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/tower_damage.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtTowerDamage" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Range" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/tower_range.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtTowerRange" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Colors -->
                <TextBlock Text="COLORS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Color 1 -->
                        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                            <TextBlock Text="Color 1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Content="PICK" DockPanel.Dock="Right" Padding="10,2" Height="22"
                                    FontSize="10" Click="BtnPickColor1_Click" />
                            <Border DockPanel.Dock="Right" x:Name="Sw1" Width="22" Height="22"
                                    Margin="8,0,8,0" CornerRadius="4"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                        </DockPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtColor1R" Text="0" beh:NumericInput.Mode="Byte" TextChanged="OnColor1Changed" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,8">
                            <TextBlock Text="G" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtColor1G" Text="0" beh:NumericInput.Mode="Byte" TextChanged="OnColor1Changed" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,8">
                            <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtColor1B" Text="0" beh:NumericInput.Mode="Byte" TextChanged="OnColor1Changed" />
                        </StackPanel>

                        <!-- Color 2 -->
                        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                            <TextBlock Text="Color 2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Content="PICK" DockPanel.Dock="Right" Padding="10,2" Height="22"
                                    FontSize="10" Click="BtnPickColor2_Click" />
                            <Border DockPanel.Dock="Right" x:Name="Sw2" Width="22" Height="22"
                                    Margin="8,0,8,0" CornerRadius="4"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                        </DockPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtColor2R" Text="0" beh:NumericInput.Mode="Byte" TextChanged="OnColor2Changed" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="4,0,4,8">
                            <TextBlock Text="G" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtColor2G" Text="0" beh:NumericInput.Mode="Byte" TextChanged="OnColor2Changed" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="8,0,0,8">
                            <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtColor2B" Text="0" beh:NumericInput.Mode="Byte" TextChanged="OnColor2Changed" />
                        </StackPanel>

                        <!-- Color 3 -->
                        <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                            <TextBlock Text="Color 3" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Content="PICK" DockPanel.Dock="Right" Padding="10,2" Height="22"
                                    FontSize="10" Click="BtnPickColor3_Click" />
                            <Border DockPanel.Dock="Right" x:Name="Sw3" Width="22" Height="22"
                                    Margin="8,0,8,0" CornerRadius="4"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                        </DockPanel>
                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtColor3R" Text="0" beh:NumericInput.Mode="Byte" TextChanged="OnColor3Changed" />
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="G" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtColor3G" Text="0" beh:NumericInput.Mode="Byte" TextChanged="OnColor3Changed" />
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtColor3B" Text="0" beh:NumericInput.Mode="Byte" TextChanged="OnColor3Changed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Identity -->
                <TextBlock Text="IDENTITY" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="Hero Name" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHeroName" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Level" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtLevel" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Experience" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtExperience" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
