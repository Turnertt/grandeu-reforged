<Window x:Class="Modinator.Views.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibration"
        Width="560" Height="520"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource ModernWindowStyle}">

    <DockPanel>
        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="LblStep"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSkip" Content="SKIP" Padding="16,7" Height="32"
                            Visibility="Collapsed" Click="BtnSkip_Click" />
                    <Button x:Name="BtnClose" Content="CLOSE" IsCancel="True" Padding="16,7" Height="32"
                            Margin="8,0,0,0" Click="BtnClose_Click" />
                    <Button x:Name="BtnContinue" Content="CONTINUE"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7" Height="32" Margin="8,0,0,0"
                            Click="BtnContinue_Click"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="G U I D E D   C A L I B R A T I O N"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Re-learns the game's memory addresses and checks that everything works. Run this after a game update, or whenever scans stop finding anything."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Body: current instruction + accumulated results -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <Border Background="{StaticResource AccentSubtleBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,9"
                        Margin="0,0,0,14">
                    <TextBlock x:Name="LblInstruction"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12.5"
                               TextWrapping="Wrap" />
                </Border>

                <StackPanel x:Name="ResultsPanel" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
