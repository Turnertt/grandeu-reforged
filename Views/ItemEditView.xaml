<UserControl x:Class="Modinator.Views.ItemEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:Modinator.Behaviors">

    <DockPanel>
        <!-- Edit mode accent strip -->
        <Border DockPanel.Dock="Top" Height="2"
                Background="{StaticResource EditAccentBrush}" />
        <!-- Top action bar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnBack"
                            Content="&#x2190;  BACK"
                            Style="{StaticResource GhostButton}"
                            Padding="14,7" Height="32"
                            Click="BtnBack_Click" />
                    <Button x:Name="BtnRefresh"
                            Content="REFRESH"
                            Padding="16,7" Height="32"
                            Margin="8,0,0,0"
                            Click="BtnRefresh_Click" />
                    <Button x:Name="BtnMax"
                            Content="MAX"
                            Padding="16,7" Height="32"
                            Margin="8,0,0,0"
                            Click="BtnMax_Click"
                            ToolTip="Fill the form with configured max values (non-zero fields only). Gear button configures the values." />
                    <Button x:Name="BtnMaxConfig"
                            Content="&#xE713;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Padding="8,7" Height="32"
                            Margin="2,0,0,0"
                            Click="BtnMaxConfig_Click"
                            ToolTip="Configure max stats" />
                    <Button x:Name="BtnUpdate"
                            Content="UPDATE"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7" Height="32"
                            Margin="8,0,0,0"
                            Click="BtnUpdate_Click" />
                    <Button x:Name="BtnDelete"
                            Content="DELETE"
                            Style="{StaticResource DangerButton}"
                            Padding="16,7" Height="32"
                            Margin="8,0,0,0"
                            Click="BtnDelete_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text=""
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border Background="{StaticResource EditAccentSubtleBrush}"
                            BorderBrush="{StaticResource EditAccentBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="{StaticResource EditAccentBrush}"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="EDIT · ITEM"
                                       Foreground="{StaticResource EditAccentBrush}"
                                       FontSize="10.5" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable form area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel MaxWidth="560">

                <!-- Hero Stats -->
                <TextBlock Text="HERO STATS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Health" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/hero_health.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtHeroHealth" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Speed" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/hero_speed.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtHeroSpeed" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Damage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/hero_damage.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtHeroDamage" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Casting" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/hero_casting.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtHeroCasting" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Skill 1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHeroSkill1" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Skill 2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHeroSkill2" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tower Stats -->
                <TextBlock Text="TOWER STATS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Health" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/tower_health.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtTowerHealth" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Speed" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/tower_speed.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtTowerSpeed" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Damage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/tower_damage.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtTowerDamage" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Range" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/tower_range.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtTowerRange" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Weapon -->
                <TextBlock Text="WEAPON" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Damage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_damage.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtDamage" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Ranged Damage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_ranged.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtRangedDamage" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Blocking" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_blocking.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtBlocking" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Knockback" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_knockback.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtKnockback" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Charge Speed" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_chargespeed.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtChargeSpeed" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Shots Per Second" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_shotspersec.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtShotsPerSecond" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="# Projectiles" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_projectiles.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtNumProjectiles" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Projectile Speed" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_projspeed.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtSpeedOfProjectiles" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Clip Ammo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_clipammo.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtClipAmmo" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Reload Speed" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/weapon_reload.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtReloadSpeed" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Draw Scale (float)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtDrawScale" Text="0" beh:NumericInput.Mode="Float" />
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Swing Speed (float)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtSwingSpeed" Text="0" beh:NumericInput.Mode="Float" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Resistance -->
                <TextBlock Text="RESISTANCE" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Generic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/resist_generic.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtGeneric" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Poison" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/resist_poison.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtPoison" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Fire" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/resist_fire.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtFire" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Lightning" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DockPanel>
                                <Image Source="/Assets/Icons/resist_lightning.png" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtLightning" Text="0" beh:NumericInput.Mode="Int" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Elemental Damage -->
                <TextBlock Text="ELEMENTAL DAMAGE" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Value" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtElementalDamage" Text="0" beh:NumericInput.Mode="Int" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Type" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <ComboBox x:Name="CboElementalType"
                                          ToolTip="Set the weapon's elemental damage class. '(keep current)' leaves it untouched; '(none — clear)' removes elemental damage. The element name is resolved automatically — no calibration." />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="0,12,0,10" />
                        <TextBlock x:Name="TxtElementalCurrent"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Quality -->
                <TextBlock Text="QUALITY" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Quality 1 (byte)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtQuality1" Text="0" beh:NumericInput.Mode="Byte" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Quality 2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox x:Name="CboQuality2" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Quality 3" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox x:Name="CboQuality3" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Quality Flag (byte)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtQualityFlag" Text="0" beh:NumericInput.Mode="Byte" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Colors -->
                <TextBlock Text="COLORS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <!-- Color 1 Override -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Color 1 Override" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                            <Button x:Name="BtnPickColor1" Content="Pick..." Padding="10,4" Margin="8,0,0,0" Click="BtnPickColor1_Click" DockPanel.Dock="Right" />
                            <Border x:Name="Color1Preview" Width="32" Height="20" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtColor1R" Text="0" TextChanged="Color1_Changed" beh:NumericInput.Mode="Int" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="G" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtColor1G" Text="0" TextChanged="Color1_Changed" beh:NumericInput.Mode="Int" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtColor1B" Text="0" TextChanged="Color1_Changed" beh:NumericInput.Mode="Int" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Color 2 Override -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Color 2 Override" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                            <Button x:Name="BtnPickColor2" Content="Pick..." Padding="10,4" Margin="8,0,0,0" Click="BtnPickColor2_Click" DockPanel.Dock="Right" />
                            <Border x:Name="Color2Preview" Width="32" Height="20" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtColor2R" Text="0" TextChanged="Color2_Changed" beh:NumericInput.Mode="Int" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="G" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtColor2G" Text="0" TextChanged="Color2_Changed" beh:NumericInput.Mode="Int" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtColor2B" Text="0" TextChanged="Color2_Changed" beh:NumericInput.Mode="Int" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Identity -->
                <TextBlock Text="IDENTITY" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="Item Name" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtItemName" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="Description" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtDescription" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Forger Name" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtForgerName" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Equipment Type" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox x:Name="CboEquipmentType" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Weapon Class" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtWeaponClass" IsReadOnly="True"
                                     Background="{StaticResource SurfaceLightBrush}"
                                     ToolTip="EWeaponType class gate (read-only). '—' for non-weapons." />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Memory Address (hex)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtMemoryAddress" Grid.Column="0"
                                     IsReadOnly="True"
                                     Background="{StaticResource SurfaceLightBrush}" />
                            <Button x:Name="BtnCopyMemoryAddress" Grid.Column="1"
                                    Content="COPY"
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    Height="32"
                                    ToolTip="Copy the memory address to clipboard"
                                    Click="BtnCopyMemoryAddress_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Equipment Template (hex)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtEquipmentTemplate" Grid.Column="0" />
                            <Button x:Name="BtnCopyTemplate" Grid.Column="1"
                                    Content="COPY"
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    Height="32"
                                    ToolTip="Copy the hex template to clipboard"
                                    Click="BtnCopyTemplate_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Economy -->
                <TextBlock Text="ECONOMY" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Maximum Value" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtMaxValue" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Minimum Value" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtMinValue" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Rating (float)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtRating" Text="0" beh:NumericInput.Mode="Float" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Rating % (float)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtRatingPercent" Text="0" beh:NumericInput.Mode="Float" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Level -->
                <TextBlock Text="LEVEL" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Level" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtLevel" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Max Level" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtMaxLevel" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Stored Mana" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtStoredMana" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Level Requirement" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtLevelRequirement" Text="0" beh:NumericInput.Mode="Byte" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="ID 1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtID1" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="ID 2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtID2" Text="0" beh:NumericInput.Mode="Int" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
