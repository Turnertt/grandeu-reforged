<Window x:Class="Modinator.Views.ChooseProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Process"
        Width="480" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource ModernWindowStyle}">
    <DockPanel Margin="0">
        <Border DockPanel.Dock="Bottom" Padding="12,10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="16,7" Margin="0,0,8,0" Click="BtnCancel_Click" />
                <Button Content="USE SELECTED" Style="{StaticResource AccentButton}" Padding="16,7" Click="BtnOk_Click" />
            </StackPanel>
        </Border>
        <ListView x:Name="ProcessList" Background="Transparent" BorderThickness="0"
                  SelectionMode="Single" Margin="8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding PID}" />
                    <GridViewColumn Header="Start Time" Width="110" DisplayMemberBinding="{Binding StartTime}" />
                    <GridViewColumn Header="Main Window" Width="250" DisplayMemberBinding="{Binding WindowTitle}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
