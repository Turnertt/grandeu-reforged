<UserControl x:Class="Modinator.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:Modinator.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="48,40,48,40">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                <Border Width="6" Height="6" CornerRadius="3"
                        Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="S E T T I N G S"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- ─── SCANNING ─── -->
            <TextBlock Text="S C A N N I N G"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10.5" FontWeight="Bold"
                       Margin="0,0,0,10" />
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="0" Margin="0,0,0,22">
                <StackPanel>
                    <Grid Margin="20,16" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Full Scanning"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Scan every address. Slower but finds misaligned structs."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton x:Name="SwFullScanning" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="SwFullScanning_Toggled"
                                      Unchecked="SwFullScanning_Toggled" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" />
                    <Grid Margin="20,16" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Pause On Scan"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Suspend DunDefGame.exe while scanning. More accurate reads."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton x:Name="SwPauseOnScan" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="SwPauseOnScan_Toggled"
                                      Unchecked="SwPauseOnScan_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ─── WINDOW ─── -->
            <TextBlock Text="W I N D O W"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10.5" FontWeight="Bold"
                       Margin="0,0,0,10" />
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20,16" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Always On Top"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Keep Modinator above DunDef while the game has focus."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleButton x:Name="SwAlwaysOnTop" Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center"
                                  Checked="SwAlwaysOnTop_Toggled"
                                  Unchecked="SwAlwaysOnTop_Toggled" />
                </Grid>
            </Border>

            <!-- ─── GAMEPLAY ─── -->
            <TextBlock Text="G A M E P L A Y"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10.5" FontWeight="Bold"
                       Margin="0,0,0,10" />
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="0" Margin="0,0,0,22">
                <StackPanel>
                    <Grid Margin="20,16" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Automate &quot;G&quot;"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Simulate a G key press every second."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton x:Name="SwSimulateG" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="SwSimulateG_Toggled"
                                      Unchecked="SwSimulateG_Toggled" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" />
                    <Grid Margin="20,16" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Auto Kill Enemies"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Set enemy health to zero every 100 ms. First tick searches for the pawn list."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton x:Name="SwAutoKill" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="SwAutoKill_Toggled"
                                      Unchecked="SwAutoKill_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ─── HOTKEYS ─── -->
            <TextBlock Text="H O T K E Y S"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10.5" FontWeight="Bold"
                       Margin="0,0,0,10" />
            <TextBlock Text="Global combos — work while DunDef has focus. Click a button then press the new combo. Must include a modifier (Ctrl/Shift/Alt). Esc cancels."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="0" Margin="0,0,0,22">
                <StackPanel>
                    <Grid Margin="20,16" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Auto Kill Enemies"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="BtnHkAutoKill" Grid.Column="1"
                                MinWidth="140" Padding="14,6" Height="30"
                                VerticalAlignment="Center"
                                Click="HkButton_Click"
                                PreviewKeyDown="HkButton_PreviewKeyDown"
                                LostFocus="HkButton_LostFocus"
                                Tag="AutoKill" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" />
                    <Grid Margin="20,16" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Automate &quot;G&quot;"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="BtnHkAutoG" Grid.Column="1"
                                MinWidth="140" Padding="14,6" Height="30"
                                VerticalAlignment="Center"
                                Click="HkButton_Click"
                                PreviewKeyDown="HkButton_PreviewKeyDown"
                                LostFocus="HkButton_LostFocus"
                                Tag="AutoG" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" />
                    <Grid Margin="20,16" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Always On Top"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="BtnHkAlwaysOnTop" Grid.Column="1"
                                MinWidth="140" Padding="14,6" Height="30"
                                VerticalAlignment="Center"
                                Click="HkButton_Click"
                                PreviewKeyDown="HkButton_PreviewKeyDown"
                                LostFocus="HkButton_LostFocus"
                                Tag="AlwaysOnTop" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ─── ACTIONS ─── -->
            <TextBlock Text="A C T I O N S"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10.5" FontWeight="Bold"
                       Margin="0,0,0,10" />
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="0" Margin="0,0,0,22">
                <Grid Margin="20,16" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="More Options"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Additional advanced settings."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="OPEN" Padding="14,6" Height="30"
                            VerticalAlignment="Center"
                            Click="BtnMoreOptions_Click" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
