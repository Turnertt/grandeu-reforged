<UserControl x:Class="Modinator.Views.ForgeViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mode accent strip -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" />

        <!-- ═══════════════════════════════════════════════════════════
             THE FORGE — Command Bar
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2b2d31" Offset="0" />
                    <GradientStop Color="#252629" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Margin="18,14,18,14">

                <!-- Row 1: Actions + Status -->
                <DockPanel>
                    <!-- Mode badge + status — right side -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="LblStatus"
                                   Text="Click SCAN ALL to populate the forge view."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10.5" FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Margin="16,0,12,0" />
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="FORGE VIEWER"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="10.5" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnScan"
                                Style="{StaticResource AccentButton}"
                                Padding="18,7" Height="32"
                                Click="BtnScan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BtnScanIcon"
                                           Text="&#xE71E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="BtnScanLabel"
                                           Text="SCAN ALL" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSelectAll"
                                Padding="14,7" Height="32"
                                Margin="8,0,0,0"
                                IsEnabled="False"
                                ToolTip="Select every item matching the current filters. Requires a specific Type."
                                Click="BtnSelectAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BtnSelectAllIcon"
                                           Text="&#xE762;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="BtnSelectAllLabel"
                                           Text="SELECT ALL" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnBulk"
                                Padding="14,7" Height="32"
                                Margin="8,0,0,0"
                                IsEnabled="False"
                                Click="BtnBulk_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="BULK EDIT" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnReset"
                                Padding="14,7" Height="32"
                                Margin="8,0,0,0"
                                ToolTip="Clear cached scan and filters; requires a fresh SCAN ALL."
                                Click="BtnReset_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="RESET" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>

                <!-- Row 2: Search bar -->
                <Grid Margin="0,12,0,0">
                    <TextBox x:Name="TxtSearch"
                             TextChanged="TxtSearch_TextChanged"
                             Padding="10,7"
                             FontSize="12" />
                    <!-- Watermark — separate TextBlocks so icon font doesn't bleed into text -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Search items by name, description, or level..."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5" Opacity="0.6"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Row 3: View filters. Pagination moved to a footer under
                     the cards; Quality dropped (still on cards + sortable).
                     One funnel glyph fronts the group; combos share a width
                     so the row stays tidy (WrapPanel keeps it robust if the
                     window is narrowed). -->
                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               ToolTip="Filter and sort the scanned items" />

                    <StackPanel Orientation="Horizontal" Margin="0,3,16,3">
                        <TextBlock Text="Source"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="CboSource"
                                  Width="160"
                                  SelectionChanged="Source_Changed" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,16,3">
                        <TextBlock Text="Type"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="CboType"
                                  Width="160"
                                  SelectionChanged="Filter_Changed" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,16,3">
                        <TextBlock Text="Sort"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="CboSort"
                                  Width="160"
                                  SelectionChanged="Filter_Changed" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,16,3">
                        <TextBlock Text="Folder"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="CboFolder"
                                  Width="160"
                                  SelectionChanged="Filter_Changed" />
                    </StackPanel>
                </WrapPanel>

                <!-- Persistent affordance — selection/edit gestures are
                     otherwise undiscoverable (was buried in status text). -->
                <TextBlock Text="Ctrl+click to select  ·  double-click to edit"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10" Opacity="0.65"
                           Margin="0,10,0,0" />

            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             Card Grid — the forge table
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <ScrollViewer x:Name="CardScroller"
                              VerticalScrollBarVisibility="Auto"
                              Padding="12">
                    <WrapPanel x:Name="CardPanel"
                               Margin="6" />
                </ScrollViewer>

                <!-- Empty / first-run placeholder. Default visible (pre-scan);
                     toggled + retitled in code on scan / filter changes. -->
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="EmptyIcon" Text="&#xE71C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="44"
                               Foreground="{StaticResource TextMutedBrush}"
                               Opacity="0.45"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText"
                               Text="Click SCAN ALL to populate the forge view."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12.5" Opacity="0.8"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Pagination footer — sits next to the content it pages;
                 hidden by UpdateEmptyState when there are no cards. -->
            <Border x:Name="PaginationBar" Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnPrev"
                            Padding="10,5" Height="28"
                            Click="BtnPrev_Click">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                    <TextBlock x:Name="LblPage"
                               Text="Page 0 / 0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               MinWidth="70"
                               TextAlignment="Center" />
                    <Button x:Name="BtnNext"
                            Padding="10,5" Height="28"
                            Click="BtnNext_Click">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
