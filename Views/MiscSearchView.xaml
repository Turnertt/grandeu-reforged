<UserControl x:Class="Modinator.Views.MiscSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:Modinator.Behaviors">

    <DockPanel>
        <!-- Mode accent strip -->
        <Border DockPanel.Dock="Top" Height="2"
                Background="{StaticResource AccentBrush}" />
        <!-- Top action bar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnFirstScan"
                            Content="FIRST SCAN"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7"
                            Click="BtnFirstScan_Click" />
                    <Button x:Name="BtnNextScan"
                            Content="NEXT SCAN"
                            Padding="16,7"
                            Margin="8,0,0,0"
                            IsEnabled="False"
                            Click="BtnNextScan_Click" />
                    <Button x:Name="BtnNewScan"
                            Content="NEW SCAN"
                            Padding="16,7"
                            Margin="8,0,0,0"
                            ToolTip="Clear inputs and results to start a fresh scan."
                            Click="BtnNewScan_Click" />
                    <Button x:Name="BtnViewGuide"
                            Content="VIEW GUIDE"
                            Padding="16,7"
                            Margin="8,0,0,0"
                            Click="BtnViewGuide_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ScanStatus"
                               Text="Select a preset or enter values manually"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border Background="{StaticResource AccentSubtleBrush}"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="SEARCH · MISC"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10.5" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable form area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel MaxWidth="560">

                <!-- Search Configuration -->
                <TextBlock Text="SEARCH CONFIGURATION" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="Presets" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox x:Name="CboPresets" SelectionChanged="CboPresets_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Search Value" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtSearchValue" Text="" beh:Placeholder.Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Ends With (hex)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtEndsWith" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                            <CheckBox x:Name="ChkFloat" Content="Search for floating point values" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
