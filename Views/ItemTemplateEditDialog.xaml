<Window x:Class="Modinator.Views.ItemTemplateEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit item template" Width="800" Height="720" MinWidth="680" MinHeight="520"
        Icon="/GrandeuReforged;component/Assets/app-icon.ico" WindowStartupLocation="CenterOwner" Style="{StaticResource ModernWindowStyle}">
    <DockPanel Background="{StaticResource BackgroundBrush}">
        <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource EditAccentBrush}"/>
        <StackPanel DockPanel.Dock="Top" Margin="22,18,22,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource EditAccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="Heading" Text="Edit template" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Text="Changes are saved to your library. Copy onto an item later through Item Dupe."
                       TextWrapping="Wrap" Margin="0,5,0,14" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="Template name" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox x:Name="TemplateName" MaxLength="120" AutomationProperties.Name="Template name"/>
            <TextBlock x:Name="BaseItem" Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" Padding="22,12">
            <StackPanel>
                <TextBlock x:Name="Status" Text="The captured base item and damage types stay fixed. Save a different source to change them."
                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Tag="&#xE711;" ContentTemplate="{StaticResource IconButtonContent}" IsCancel="True" Padding="14,7" Height="32"/>
                    <Button x:Name="BtnSaveNew" Content="SAVE AS NEW" Tag="&#xE8C8;" ContentTemplate="{StaticResource IconButtonContent}" Padding="14,7" Height="32" Margin="8,0,0,0" Click="SaveNew_Click"/>
                    <Button x:Name="BtnSave" Content="SAVE CHANGES" Padding="14,7" Height="32" Margin="8,0,0,0"
                            Tag="&#xE74E;" ContentTemplate="{StaticResource IconButtonContent}" Style="{StaticResource AccentButton}" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Section tabs across the top, like the dupe pickers. -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="22,0,22,14">
            <StackPanel x:Name="Tabs" Orientation="Horizontal"/>
        </Border>
        <ScrollViewer x:Name="EditorScroll" Margin="22,0,22,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Fields" Margin="0,0,12,0"/>
        </ScrollViewer>
    </DockPanel>
</Window>
