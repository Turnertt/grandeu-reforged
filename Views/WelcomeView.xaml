<UserControl x:Class="Modinator.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Atmospheric accent glow anchored top-center -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.02"
                                 GradientOrigin="0.5,0.02"
                                 RadiusX="0.9" RadiusY="0.55">
                <GradientStop Color="#1e5865f2" Offset="0" />
                <GradientStop Color="#001e1f22" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="880" Margin="48,56,48,40">

                <!-- ═══════════ Hero ═══════════ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,36"
                            VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="G R A N D E U · R E F O R G E D"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <!-- Version card -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,5" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="VersionText"
                                       Text="v0.0.0"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Connection card -->
                    <Border x:Name="StatusPill"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,5"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{StaticResource DangerBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusLabel"
                                       Text="DunDefGame.exe not running"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Compatibility card -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,5" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="The latest DD1 build this version was verified working on. DD1 patches ~weekly; bump this after a verified health check.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{StaticResource SuccessBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="CompatText"
                                       Text="Working as of DD1 v0.0.0"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════ Destination tiles ═══════════ -->
                <TextBlock Text="G O   T O"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10.5" FontWeight="Bold"
                           Margin="0,0,0,14" />

                <!-- Row 1: the three primary tools -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource TileButton}"
                            Click="Tile_Click" Tag="ForgeViewer">
                        <StackPanel>
                            <Grid Margin="0,0,0,14" HorizontalAlignment="Left">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}" />
                                <TextBlock Text="&#xE71C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Forge Viewer"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Browse every item in your forge by folder. Double-click to edit, or bulk-edit a whole folder."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource TileButton}"
                            Click="Tile_Click" Tag="HeroViewer">
                        <StackPanel>
                            <Grid Margin="0,0,0,14" HorizontalAlignment="Left">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}" />
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Hero Viewer"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Every hero's stats, level and equipped gear in one place. Double-click a hero or an item to edit it."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource TileButton}"
                            Click="Tile_Click" Tag="ItemDupe">
                        <StackPanel>
                            <Grid Margin="0,0,0,14" HorizontalAlignment="Left">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}" />
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Item Dupe"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Copy one item's stats onto another. Pick a source and a target, then overwrite."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 2: tip card + update tile (half-width each). The
                     Item / Hero / Misc memory-search tools now live under
                     "Advanced" in the sidebar. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Onboarding tip card -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="22,20">
                        <StackPanel>
                            <TextBlock Text="T I P"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="Need the raw memory-search tools (Item / Hero / Misc)? They're under &#x201C;Advanced&#x201D; in the sidebar. Double-click any result to open its editor."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Border>

                    <!-- Update tile -->
                    <Button Grid.Column="2" Style="{StaticResource TileButton}"
                            Click="OpenLink_Click"
                            Tag="https://github.com/Turnertt/grandeu-reforged"
                            ToolTip="Opens the GrandeuReforged GitHub page in your browser">
                        <StackPanel>
                            <Grid Margin="0,0,0,14" HorizontalAlignment="Left">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}" />
                                <TextBlock Text="&#xE896;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Get Latest Version"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Download the newest build from GitHub — grab it after a DD1 patch if something stops working."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
