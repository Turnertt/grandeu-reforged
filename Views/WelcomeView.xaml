<UserControl x:Class="Modinator.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Atmospheric accent glow anchored top-center -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.02"
                                 GradientOrigin="0.5,0.02"
                                 RadiusX="0.9" RadiusY="0.55">
                <GradientStop Color="#1e5865f2" Offset="0" />
                <GradientStop Color="#001e1f22" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="880" Margin="48,56,48,40">

                <!-- ═══════════ Hero ═══════════ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,36"
                            VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="G R A N D E U · R E F O R G E D"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <!-- Version card -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,5" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="VersionText"
                                       Text="v0.0.0"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Connection card -->
                    <Border x:Name="StatusPill"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,5"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{StaticResource DangerBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusLabel"
                                       Text="DunDefGame.exe not running"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Compatibility card -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,5" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="The latest DD1 build this version was verified working on. DD1 patches ~weekly; bump this after a verified health check.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{StaticResource SuccessBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="CompatText"
                                       Text="Working as of DD1 v0.0.0"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════ Destination tiles ═══════════ -->
                <TextBlock Text="G O   T O"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10.5" FontWeight="Bold"
                           Margin="0,0,0,14" />

                <!-- Row 1: three tiles -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource TileButton}"
                            Click="Tile_Click" Tag="ItemSearch">
                        <StackPanel>
                            <Grid Margin="0,0,0,14" HorizontalAlignment="Left">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}" />
                                <TextBlock Text="&#xECAD;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Items"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Scan for weapons, armor and accessories. Edit stats, forger, quality."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource TileButton}"
                            Click="Tile_Click" Tag="HeroSearch">
                        <StackPanel>
                            <Grid Margin="0,0,0,14" HorizontalAlignment="Left">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}" />
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Heroes"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Find hero structs to edit stats, level, colors and name."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource TileButton}"
                            Click="Tile_Click" Tag="ForgeViewer">
                        <StackPanel>
                            <Grid Margin="0,0,0,14" HorizontalAlignment="Left">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}" />
                                <TextBlock Text="&#xE71C;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Forge Viewer"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Browse every item in your forge by folder. Bulk-edit across a whole folder."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 2: misc tile + tip card + update tile (3 equal
                     slots, mirrors Row 1. Location tile removed — tracked
                     Location items still open via the sidebar results). -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource TileButton}"
                            Click="Tile_Click" Tag="MiscSearch">
                        <StackPanel>
                            <Grid Margin="0,0,0,14" HorizontalAlignment="Left">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}" />
                                <TextBlock Text="&#xE950;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Misc Values"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Search for any 4-byte int or float — mana, wave number, gold."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Button>

                    <!-- Onboarding tip card -->
                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="22,20">
                        <StackPanel>
                            <TextBlock Text="T I P"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="Double-click a result to open its editor. Tracked items stay in the list below — freeze, rename, or edit them any time."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Border>

                    <!-- Update tile -->
                    <Button Grid.Column="4" Style="{StaticResource TileButton}"
                            Click="OpenLink_Click"
                            Tag="https://github.com/Turnertt/grandeu-reforged"
                            ToolTip="Opens the GrandeuReforged GitHub page in your browser">
                        <StackPanel>
                            <Grid Margin="0,0,0,14" HorizontalAlignment="Left">
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}" />
                                <TextBlock Text="&#xE896;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Get Latest Version"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Download the newest build from GitHub — grab it after a DD1 patch if something stops working."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
