<UserControl x:Class="Modinator.Views.LocationEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:Modinator.Behaviors">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="2"
                Background="{StaticResource EditAccentBrush}" />
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Content="&#x2190;  BACK"
                            Style="{StaticResource GhostButton}"
                            Padding="14,7" Height="32" Click="BtnBack_Click" />
                    <Button x:Name="BtnRefresh" Content="REFRESH" Padding="16,7" Height="32" Margin="8,0,0,0" Click="BtnRefresh_Click" />
                    <Button x:Name="BtnUpdate" Content="UPDATE" Style="{StaticResource AccentButton}"
                            Padding="16,7" Height="32" Margin="8,0,0,0" Click="BtnUpdate_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource EditAccentSubtleBrush}"
                            BorderBrush="{StaticResource EditAccentBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="{StaticResource EditAccentBrush}"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="EDIT · LOCATION"
                                       Foreground="{StaticResource EditAccentBrush}"
                                       FontSize="10.5" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceLightBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,5"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Location"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       MaxWidth="320"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel MaxWidth="480">
                <TextBlock Text="CURRENT POSITION" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="X" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCurX" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="Y" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCurY" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="Z" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCurZ" IsReadOnly="True" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="NEW POSITION" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="X" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtNewX" Text="0" beh:NumericInput.Mode="Float" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="Y" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtNewY" Text="0" beh:NumericInput.Mode="Float" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="Z" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtNewZ" Text="0" beh:NumericInput.Mode="Float" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
