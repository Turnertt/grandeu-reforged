<Window x:Class="Modinator.Views.MoreOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="More Options"
        Width="300" Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource ModernWindowStyle}">
    <StackPanel Margin="20,16">
        <TextBlock Text="Freeze Timer (ms)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
        <TextBox x:Name="TxtFreezeTimer" Text="10" Margin="0,0,0,12" />
        <TextBlock Text="Refresh Timer (ms)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
        <TextBox x:Name="TxtRefreshTimer" Text="5000" Margin="0,0,0,4" />
        <CheckBox x:Name="ChkDisableRefresh" Content="Disable refresh" Margin="0,4,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="RESET" Padding="16,7" Margin="0,0,8,0" Click="BtnReset_Click" />
            <Button Content="OK" Style="{StaticResource AccentButton}" Padding="16,7" Click="BtnOk_Click" />
        </StackPanel>
    </StackPanel>
</Window>
