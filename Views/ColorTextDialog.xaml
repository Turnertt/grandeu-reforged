<Window x:Class="Modinator.Views.ColorTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Editor"
        Width="640" Height="560"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource ModernWindowStyle}">

    <DockPanel>
        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="LblLength"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="CANCEL" IsCancel="True"
                            Padding="16,7" Height="32" Click="BtnCancel_Click" />
                    <Button x:Name="BtnOk" Content="APPLY"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7" Height="32" Margin="8,0,0,0"
                            IsDefault="True" Click="BtnOk_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="LblTitle" Text="Description"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Select some text, then click a color. Colors are stored as DD1 &lt;color&gt; tags."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Unsellable warning (forger name only) -->
        <Border x:Name="WarnBar" DockPanel.Dock="Top"
                Background="{StaticResource SurfaceLightBrush}"
                BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="3,0,0,0"
                Padding="14,10" Margin="16,12,16,0"
                CornerRadius="4"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="This makes the item unsellable"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="A custom forger name written from outside the game is never marked as verified, so the game refuses to let the item be sold. Clear the forger name to make it sellable again."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Palette -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,12" Margin="16,0,16,12"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="COLOR" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel x:Name="Swatches" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="TxtR" Width="46" Text="255" />
                    <TextBlock Text="G" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <TextBox x:Name="TxtG" Width="46" Text="255" />
                    <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <TextBox x:Name="TxtB" Width="46" Text="255" />
                    <Button x:Name="BtnApplyRgb" Content="APPLY TO SELECTION"
                            Padding="12,5" Height="28" Margin="12,0,0,0"
                            Click="BtnApplyRgb_Click" />
                    <Button x:Name="BtnClear" Content="REMOVE COLOR"
                            Style="{StaticResource GhostButton}"
                            Padding="12,5" Height="28" Margin="8,0,0,0"
                            ToolTip="Return the selected text to the game's default color."
                            Click="BtnClear_Click" />
                    <Button x:Name="BtnRainbow" Content="RAINBOW"
                            Style="{StaticResource GhostButton}"
                            Padding="12,5" Height="28" Margin="8,0,0,0"
                            ToolTip="Sweep a hue gradient across the selected text, one color per letter."
                            Click="BtnRainbow_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Editor -->
        <Border Background="{StaticResource InputBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="16,12,16,12">
            <RichTextBox x:Name="Editor"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,8"
                         FontSize="14"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         SelectionChanged="Editor_SelectionChanged"
                         TextChanged="Editor_TextChanged" />
        </Border>
    </DockPanel>
</Window>
