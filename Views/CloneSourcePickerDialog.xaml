<Window x:Class="Modinator.Views.CloneSourcePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:beh="clr-namespace:Modinator.Behaviors"
        Title="Pick item"
        Width="760" Height="560"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource ModernWindowStyle}">

    <DockPanel>
        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="LblCount"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Padding="16,7" Height="32" Click="BtnCancel_Click" />
                    <Button x:Name="BtnOk" Content="USE AS SOURCE"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7" Height="32" Margin="8,0,0,0"
                            Click="BtnOk_Click"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header + filter -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="LblPrompt"
                           Text="Pick the item whose stats you want to copy onto the sacrificial."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFilter"
                             Grid.Column="0"
                             FontSize="13"
                             beh:Placeholder.Text="Search name, forger, type..."
                             TextChanged="TxtFilter_TextChanged" />
                    <ComboBox x:Name="CboSource"   Grid.Column="1" Margin="8,0,0,0" SelectionChanged="Filter_Changed" />
                    <ComboBox x:Name="CboType"     Grid.Column="2" Margin="8,0,0,0" SelectionChanged="Filter_Changed" />
                    <ComboBox x:Name="CboQuality"  Grid.Column="3" Margin="8,0,0,0" SelectionChanged="Filter_Changed" />
                    <ComboBox x:Name="CboSort"     Grid.Column="4" Margin="8,0,0,0" SelectionChanged="Filter_Changed" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnClearFilters"
                            Content="CLEAR FILTERS"
                            Padding="10,5" Height="28" FontSize="11"
                            Click="BtnClearFilters_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- List of candidate source items -->
        <ListView x:Name="Lv"
                  MouseDoubleClick="Lv_DoubleClick"
                  BorderThickness="0"
                  Background="{StaticResource BackgroundBrush}"
                  Padding="8,4">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Quality"  DisplayMemberBinding="{Binding Quality}"  Width="90" />
                    <GridViewColumn Header="Name"     DisplayMemberBinding="{Binding Name}"     Width="230" />
                    <GridViewColumn Header="Type"     DisplayMemberBinding="{Binding Type}"     Width="110" />
                    <GridViewColumn Header="Level"    DisplayMemberBinding="{Binding Level}"    Width="60" />
                    <GridViewColumn Header="Forger"   DisplayMemberBinding="{Binding Forger}"   Width="130" />
                    <GridViewColumn Header="Address"  DisplayMemberBinding="{Binding AddressText}" Width="90" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
