<UserControl x:Class="Modinator.Views.ItemDupeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="DupePanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ItemNameText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxHeight" Value="48" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" />

        <!-- Top bar: badge + status on the left, actions on the right (one pattern on every screen). -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="ITEM DUPE" Foreground="{StaticResource AccentBrush}"
                                       FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="5" Padding="10,5" Margin="10,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="Pick a source and a target item."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="BtnDupe" Content="OVERWRITE TARGET" Tag="&#xE8C8;" ContentTemplate="{StaticResource IconButtonContent}" Style="{StaticResource DangerButton}"
                            Padding="14,7" Height="32" IsEnabled="False" ToolTip="Replace the target item with a copy of the source. Asks before writing." Click="BtnDupe_Click" />
                    <Button x:Name="BtnReset" Content="RESET" Tag="&#xE7A7;" ContentTemplate="{StaticResource IconButtonContent}"
                            Padding="14,7" Height="32" Margin="8,0,0,0" ToolTip="Clear the picked source and target." Click="BtnReset_Click" />
                    <Button x:Name="BtnCancelOperation" Content="CANCEL" Tag="&#xE711;" ContentTemplate="{StaticResource IconButtonContent}"
                            Padding="14,7" Height="32" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Stop the current read. Nothing is written once cancelled." Click="BtnCancelOperation_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Padding="18,10" Background="{StaticResource BackgroundBrush}">
            <StackPanel>
                <TextBlock x:Name="TxtCopyHelp" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Copy stats, item type, supported appearance and text. The target keeps its own identity. PICK SOURCE offers your own items, saved templates, and other players&apos; gear or floor items; all of them follow the same Dupe rules."/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"
                           Text="Appearance: the copy keeps the sacrificial item's old skin/look until you drop it. Drop it and pick it back up to refresh the skin/texture."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24">
            <Grid MaxWidth="1120"
                  HorizontalAlignment="Center">
                <!-- Two cards with the copy-direction arrow living IN the
                     gap between them (the old separate flow-header panel
                     restated what the card headers already say). -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Border Width="40" Height="40"
                                CornerRadius="20"
                                Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1.5"
                                ToolTip="The source is copied onto the target">
                            <TextBlock Text="&#xE72A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="COPIES"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="ONTO"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="0"
                            Style="{StaticResource DupePanel}"
                            MinHeight="430">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource SurfaceLightBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,13">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30"
                                                CornerRadius="6"
                                                Background="{StaticResource AccentSubtleBrush}"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="&#xE8C8;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="SOURCE"
                                                       Style="{StaticResource PanelLabel}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="The item to copy"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button x:Name="BtnPickSource"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="PICK SOURCE"
                                            Tag="&#xE8B7;" ContentTemplate="{StaticResource IconButtonContent}"
                                            Padding="14,7"
                                            Height="32"
                                            ToolTip="Choose what gets copied: one of your items, a saved template, or another player&apos;s gear / a floor item. It is never modified."
                                            Click="BtnPickSource_Click" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <!-- Empty state: shown until a source is picked -->
                                <StackPanel x:Name="SrcEmpty"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="24">
                                    <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Border Width="56" Height="56"
                                                CornerRadius="28"
                                                Background="{StaticResource SurfaceLightBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" />
                                        <TextBlock Text="&#xE8C8;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="No source selected"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Pick an item, a template, or another player&apos;s gear to duplicate."
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="230"
                                               Margin="0,5,0,0" />
                                </StackPanel>

                                <ScrollViewer x:Name="SrcBody"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="18,18,14,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSrcName"
                                                   Style="{StaticResource ItemNameText}" />
                                        <TextBlock x:Name="TxtSrcMeta"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,7,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtSrcAddr"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Margin="0,6,0,0" />
                                        <StackPanel x:Name="SrcStats" Margin="0,14,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,8,8"
                                    Padding="14,10">
                                <StackPanel>
                                    <Button x:Name="BtnSaveTemplate" Content="ADD TO TEMPLATES" Tag="&#xE8F1;"
                                            ContentTemplate="{StaticResource IconButtonContent}"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,5" HorizontalAlignment="Center" Margin="0,0,0,8"
                                            Visibility="Collapsed"
                                            ToolTip="Save the source item to the template library (Templates tab)."
                                            Click="BtnSaveTemplate_Click"/>
                                    <TextBlock Text="Never modified"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource DupePanel}"
                            MinHeight="430">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource SurfaceLightBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,13">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30"
                                                CornerRadius="6"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource DangerBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="TARGET"
                                                       Style="{StaticResource PanelLabel}"
                                                       Foreground="{StaticResource DangerBrush}" />
                                            <TextBlock Text="Becomes the copy"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button x:Name="BtnPickSacrificial"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="PICK TARGET"
                                            Tag="&#xE8B7;" ContentTemplate="{StaticResource IconButtonContent}"
                                            Padding="14,7"
                                            Height="32"
                                            ToolTip="Choose the item that becomes the copy. Its own stats are lost."
                                            Click="BtnPickSacrificial_Click" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <!-- Empty state: shown until a target is picked -->
                                <StackPanel x:Name="SacEmpty"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="24">
                                    <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Border Width="56" Height="56"
                                                CornerRadius="28"
                                                Background="{StaticResource SurfaceLightBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" />
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="No target selected"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Pick a throwaway item — it will be permanently overwritten."
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="230"
                                               Margin="0,5,0,0" />
                                </StackPanel>

                                <ScrollViewer x:Name="SacBody"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="18,18,14,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSacName"
                                                   Style="{StaticResource ItemNameText}" />
                                        <TextBlock x:Name="TxtSacMeta"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,7,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtSacAddr"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Margin="0,6,0,0" />
                                        <StackPanel x:Name="SacStats" Margin="0,14,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,8,8"
                                    Padding="14,10">
                                <StackPanel>
                                    <Button x:Name="BtnSaveTargetTemplate" Content="ADD TO TEMPLATES" Tag="&#xE8F1;"
                                            ContentTemplate="{StaticResource IconButtonContent}"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,5" HorizontalAlignment="Center" Margin="0,0,0,8"
                                            Visibility="Collapsed"
                                            ToolTip="Save the target item to the template library before it is overwritten."
                                            Click="BtnSaveTargetTemplate_Click"/>
                                    <TextBlock Text="Permanently overwritten"
                                               Foreground="{StaticResource DangerBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
