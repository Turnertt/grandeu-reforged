<UserControl x:Class="Modinator.Views.MiscEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:Modinator.Behaviors">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="2"
                Background="{StaticResource EditAccentBrush}" />
        <!-- Top bar: badge + status on the left, actions on the right (one pattern on every screen). -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Content="BACK" Tag="&#xE72B;" ContentTemplate="{StaticResource IconButtonContent}" Style="{StaticResource GhostButton}"
                            Padding="14,7" Height="32" ToolTip="Go back to the previous screen." Click="BtnBack_Click" />
                    <Border Background="{StaticResource EditAccentSubtleBrush}" BorderBrush="{StaticResource EditAccentBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource EditAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="EDIT · MISC" Foreground="{StaticResource EditAccentBrush}"
                                       FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="5" Padding="10,5" Margin="10,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="StatusText"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="BtnUpdate" Content="UPDATE" Tag="&#xE74E;" ContentTemplate="{StaticResource IconButtonContent}" Style="{StaticResource AccentButton}"
                            Padding="14,7" Height="32" ToolTip="Write the new value to the game. (Enter works too.)" Click="BtnUpdate_Click" />
                    <Button x:Name="BtnRefresh" Content="REFRESH" Tag="&#xE72C;" ContentTemplate="{StaticResource IconButtonContent}"
                            Padding="14,7" Height="32" Margin="8,0,0,0" ToolTip="Re-read the value from the game." Click="BtnRefresh_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel MaxWidth="400">
                <TextBlock Text="VALUE" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Value" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtValue" Text="0" beh:NumericInput.Mode="Int" KeyDown="TxtValue_KeyDown" />
                        <TextBlock x:Name="TxtFloatLabel" Text="(Floating Point Value)"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
